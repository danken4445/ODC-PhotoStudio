# ODC-PhotoStudio Environment Configuration Template
# Never commit real credentials or secrets to version control.
# Desktop builds must NEVER embed SUPABASE_SERVICE_ROLE_KEY or OFFLINE_GRANT_PRIVATE_KEY_PEM.

# --- Public / Shared Configuration ---
NEXT_PUBLIC_APP_NAME="ODC-PhotoStudio"
NEXT_PUBLIC_GALLERY_ORIGIN="https://gallery.odc-photostudio.example.com"
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-placeholder"

# --- Server-Only Secrets (Web Portal / Cloud Worker ONLY) ---
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-placeholder-server-only"
OFFLINE_GRANT_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\nplaceholder\n-----END PRIVATE KEY-----"
OFFLINE_GRANT_PUBLIC_KEY_PEM="-----BEGIN PUBLIC KEY-----\nplaceholder\n-----END PUBLIC KEY-----"
TOKEN_PEPPER_SECRET="replace-with-32-byte-hex-server-pepper"
CRON_WORKER_SECRET="replace-with-cron-worker-bearer-secret"

# --- Operator Desktop Local Settings ---
ODC_DESKTOP_MODE="mock"
ODC_STATION_ID="00000000-0000-4000-8000-000000000001"
ODC_DATA_DIR="./tmp/odc-photostudio-data"
ODC_PORTAL_API_URL="http://localhost:3000"
